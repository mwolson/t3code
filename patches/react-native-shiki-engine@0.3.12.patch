diff --git a/android/CMakeLists.txt b/android/CMakeLists.txt
index 005caaf255529389c2684dbe8fbf0cb099d80e97..34357afa65d7c948d86cd23d81ccbe338c9f981f 100644
--- a/android/CMakeLists.txt
+++ b/android/CMakeLists.txt
@@ -5,8 +5,11 @@ set(CMAKE_VERBOSE_MAKEFILE ON)
 
 # Find prebuilt oniguruma library
 find_library(LOG_LIB log)
+# Only the bundled per-ABI build: the default search paths include the build
+# host's /usr/lib, where a host libonig.so cannot link into an Android target.
 find_library(ONIG_LIB onig
     PATHS ${CMAKE_CURRENT_SOURCE_DIR}/src/main/jniLibs/${ANDROID_ABI}
+    NO_DEFAULT_PATH
     NO_CMAKE_FIND_ROOT_PATH
     REQUIRED
 )
